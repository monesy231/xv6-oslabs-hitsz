+// 返回连续可读长度，允许字符串在保护页前正常结束。
+static uint64 user_readable(pagetable_t pagetable, uint64 va, uint64 len) {
+  uint64 done = 0;
+  if (va >= PLIC) return 0;
+  // 用减法限制读取范围，避免 va + len 溢出。
+  if (len > PLIC - va) len = PLIC - va;
+  while (done < len) {
