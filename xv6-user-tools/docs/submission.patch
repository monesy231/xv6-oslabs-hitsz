diff --git a/user/find.c b/user/find.c
new file mode 100644
index 0000000..ce1463d
--- /dev/null
+++ b/user/find.c
@@ -0,0 +1,98 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+#include "kernel/fs.h"
+
+// 在 path 目录下递归查找 name
+void
+find(char *path, char *name)
+{
+  char buf[512], *p;
+  int fd;
+  struct dirent de;
+  struct stat st;
+
+  // 只读打开当前路径，失败时结束本层查找。
+  if ((fd = open(path, 0)) < 0) {
+    fprintf(2, "find: cannot open %s\n", path);
+    return;
+  }
+
+  // fstat 判断当前路径是文件还是目录。
+  if (fstat(fd, &st) < 0) {
+    fprintf(2, "find: cannot stat %s\n", path);
+    close(fd);
+    return;
+  }
+
+  switch (st.type) {
+
+  case T_FILE:
+    // 普通文件不再向下遍历。
+    break;
+
+  case T_DIR:
+    // 为斜杠、目录项名字和字符串结束符留够空间。
+    if (strlen(path) + 1 + DIRSIZ + 1 > sizeof(buf)) {
+      printf("find: path too long\n");
+      break;
+    }
+
+    // 拼接子项路径，p 指向文件名的位置。
+    strcpy(buf, path);
+
+    p = buf + strlen(buf);
+
+    *p++ = '/';
+
+    // 每次读取一个完整目录项，读不到时结束遍历。
+    while (read(fd, &de, sizeof(de)) == sizeof(de)) {
+
+      // inum 为 0 表示空目录项。
+      if (de.inum == 0)
+        continue;
+
+      // 目录项名字可能没有结束符，复制后手动补 0。
+      memmove(p, de.name, DIRSIZ);
+      p[DIRSIZ] = 0;
+
+      // 跳过自身和父目录，避免无限递归。
+      if (strcmp(p, ".") == 0 || strcmp(p, "..") == 0)
+        continue;
+
+      // 文件和目录都匹配；同名目录只在这里输出一次。
+      if (strcmp(p, name) == 0) {
+        printf("%s\n", buf);
+      }
+
+      if (stat(buf, &st) < 0) {
+        printf("find: cannot stat %s\n", buf);
+        continue;
+      }
+
+      // 递归只检查子项，不重复输出当前目录。
+      if (st.type == T_DIR) {
+        find(buf, name);
+      }
+    }
+
+    break;
+  }
+
+  // 关闭本层打开的描述符，避免递归时耗尽资源。
+  close(fd);
+}
+
+int
+main(int argc, char *argv[])
+{
+  // argv[1] 是起始目录，argv[2] 是要查找的名字。
+  if (argc != 3) {
+    fprintf(2, "usage: find <path> <name>\n");
+    exit(1);
+  }
+
+  find(argv[1], argv[2]);
+
+  exit(0);
+}
\ No newline at end of file
diff --git a/user/pingpong.c b/user/pingpong.c
new file mode 100644
index 0000000..d8b23bb
--- /dev/null
+++ b/user/pingpong.c
@@ -0,0 +1,70 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+    // 管道只能单向传输，往返通信需要两条。
+    int p2c[2];   // 父写子读：0 是读端，1 是写端
+    int c2p[2];   // 子写父读
+
+    pipe(p2c);
+    pipe(c2p);
+
+    // 先建管道再 fork，父子进程才能使用同一组管道。
+    int pid = fork();
+
+    if(pid < 0){
+        fprintf(2, "fork failed\n");
+        exit(1);
+    }
+
+    // fork 在子进程中返回 0，在父进程中返回子 PID。
+    if(pid == 0){
+        // 子进程读 p2c、写 c2p，其余端点关闭。
+        close(p2c[1]);
+        close(c2p[0]);
+
+        int parent_pid;
+
+        // 按一个 int 的长度读取父 PID，再打印 ping。
+        read(p2c[0], &parent_pid, sizeof(parent_pid));
+
+        printf("%d: received ping from pid %d\n",
+               getpid(), parent_pid);
+
+        // 把自己的 PID 作为回复内容。
+        int child_pid = getpid();
+        write(c2p[1], &child_pid, sizeof(child_pid));
+
+        close(p2c[0]);
+        close(c2p[1]);
+
+        exit(0);
+    } else {
+        // 父进程写 p2c、读 c2p，其余端点关闭。
+        close(p2c[0]);
+        close(c2p[1]);
+
+        int parent_pid = getpid();
+
+        // PID 通过管道传递，不能假定父子 PID 相邻。
+        write(p2c[1], &parent_pid, sizeof(parent_pid));
+
+        close(p2c[1]);
+
+        int child_pid;
+
+        // 等子进程回复后再打印 pong，保证输出顺序。
+        read(c2p[0], &child_pid, sizeof(child_pid));
+
+        printf("%d: received pong from pid %d\n",
+               getpid(), child_pid);
+
+        close(c2p[0]);
+
+        // 回收子进程，避免留下僵尸进程。
+        wait(0);
+        exit(0);
+    }
+}
